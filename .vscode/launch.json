{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Traffic App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Detector demo (OpenCV window)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/detector.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal"
    }
  ]
}
